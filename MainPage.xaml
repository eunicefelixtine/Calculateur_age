<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalculateurAge.MainPage"
    Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label
                Text="Nom"
                FontSize="16" />

            <Entry
                Text="{Binding Nom, Mode=TwoWay}"
                Placeholder="Votre nom" />

            <Label
                Text="Date de naissance"
                FontSize="16" />

            <DatePicker
                Date="{Binding DateNaissance}" />

            <Button
                Text="Calculer"
                Command="{Binding CalculerCommand}" />

            <Button
                Text="Effacer"
                Command="{Binding EffacerCommand}" />

            <Label
                Text="{Binding Resultat}"
                FontSize="20"
                IsVisible="{Binding ResultatVisible}" />

            <Label
                Text="{Binding MessageAge}"
                FontSize="18"
                IsVisible="{Binding ResultatVisible}" />

            <Label
                Text="{Binding MessageAnniversaire}"
                FontSize="18"
                IsVisible="{Binding ResultatVisible}" />

            <Label
                Text="Historique des calculs"
                FontSize="18"
                FontAttributes="Bold" />

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding HistoriqueCalculs}"
                Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Text="{Binding .}"
                            FontSize="16" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
